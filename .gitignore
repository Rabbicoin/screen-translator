# Что НЕ хранится в истории версий.
#
# Правило простое: в историю идёт то, что написано руками, и не идёт то, что
# программа делает сама. Восстанавливать сгенерированное не нужно — оно
# получается заново из того, что здесь лежит.

# Результат сборки: 187 МБ, пересобирается «Сборка.bat» за полминуты
dist/
build/

# Иконка рисуется build.py при каждой сборке
icon.ico

# Служебное от Python
__pycache__/
*.pyc

# Личное для этого компьютера: свои горячие клавиши, своё оформление и место
# для ключа платного сервиса перевода. У каждого свой, программа создаёт его
# при первом запуске из значений по умолчанию.
config.json

# Кэш объявления с сайта — обновляется сам раз в сутки
promo_cache.json

# Локальные настройки Claude Code — своё для каждого компьютера
.claude/

# Постороннее, что оказалось в папке программы: логотипы для сайта и скачанные
# установщики. Файлы на диске остаются, просто к истории программы отношения
# не имеют — логотипам место в проекте сайта.
сайт/
